#!/usr/bin/env bash
set -euo pipefail
archive_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
archive_node=""
if command -v node >/dev/null 2>&1; then archive_node="$(command -v node)"; fi
if [ -x "$archive_root/.runtime/node/bin/node" ]; then archive_node="$archive_root/.runtime/node/bin/node"; fi
if [ ! -x "$archive_node" ]; then echo "Install Node.js 24 or newer and put node on PATH to run Libregram." >&2; exit 1; fi
export PATH="$(dirname -- "$archive_node"):$PATH"
cd -- "$archive_root"
if [ "$#" -eq 0 ]; then set -- start; fi
exec "$archive_node" "$archive_root/scripts/site.mjs" "$@"
