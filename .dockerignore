# Allow only public application source into the build context. In particular,
# never send an installation's environment, media, database, state or work/.
**
!Dockerfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.mjs
!next-env.d.ts
!tsconfig.json
!postcss.config.mjs
!tailwind.config.ts
!LICENSE
!README.md
!SECURITY.md
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!scripts/
!scripts/**
!docs/
!docs/**
!deploy/
!deploy/docker/
!deploy/docker/**
!prisma/
!prisma/schema.prisma
!public/
!public/uploads/
!public/uploads/.gitkeep
# Defense in depth if an allowed source directory contains local artifacts.
**/.env*
**/*.db*
**/*.sqlite*
**/*.pem
**/*.key
**/*.log
**/*.bak
**/*.jpg
**/*.jpeg
**/*.png
**/*.webp
**/*.gif
**/*.heic
**/*.mp4
**/*.mov
**/*.webm
**/*.mp3
**/*.wav
**/*.m4a
**/*.aac
**/*.ogg
**/*.flac
**/*.opus
**/node_modules/**
**/.runtime/**
**/work/**
public/uploads/**
!public/uploads/.gitkeep
