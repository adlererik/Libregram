DATABASE_URL="file:./dev.db"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="set-your-own-password"
SESSION_SECRET="replace-with-a-long-random-secret"
# Optional age labels: enter the actual birthday as YYYY-MM-DD, then rebuild.
# Blank leaves age labels hidden rather than inventing a birthday.
NEXT_PUBLIC_BIRTH_DATE=""
SESSION_COOKIE_SECURE="false"
TRUST_PROXY="false"
# Optional server overrides; legacy ARCHIVE_HOST / ARCHIVE_PORT still work.
# LIBREGRAM_HOST="0.0.0.0"
# LIBREGRAM_PORT="3000"
# Optional stable public origin for shared-link thumbnail previews.
# LIBREGRAM_PUBLIC_ORIGIN="https://libregram.example.com"
# Visitor city estimates: local (default), or ip2location for the free HTTPS API.
# Keyless IP2Location.io needs no account; requests are capped at 900 per UTC day.
VISITOR_GEO_PROVIDER="local"
# Optional free-account API key; keep it private. Never use a paid plan here.
# IP2LOCATION_API_KEY="your-free-api-key"
# Administrator login: password (default) or cloudflare.
# Cloudflare sign-in requires HTTPS and the exact owner email in an Access Allow policy.
ADMIN_AUTH_MODE="password"
# CLOUDFLARE_ACCESS_TEAM_DOMAIN="your-team.cloudflareaccess.com"
# CLOUDFLARE_ACCESS_AUD="your-64-character-application-audience-tag"
# CLOUDFLARE_ACCESS_EMAIL="owner@example.com"
# CLOUDFLARE_ACCESS_HOSTNAME="libregram.example.com"
# Optional: TV-reachable origin for media casting, usually your HTTPS site URL.
# CAST_MEDIA_ORIGIN="https://libregram.example.com"
