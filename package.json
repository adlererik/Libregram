{
  "name": "libregram",
  "version": "1.6.0",
  "description": "A free, self-hosted Instagram alternative without media lock-in. Share photo/video compilations with one URL, AirPlay, or Google Cast.",
  "repository": { "type": "git", "url": "https://github.com/adlererik/libregram.git" },
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "LIBREGRAM_DEV=true node scripts/server.mjs",
    "build": "prisma generate && next build",
    "setup:env": "node scripts/setup.mjs",
    "start": "node scripts/site.mjs start",
    "restart": "node scripts/site.mjs restart",
    "db:push": "prisma db push",
    "import:instagram": "tsx scripts/import-instagram.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "framer-motion": "^12.23.24",
    "geoip-lite": "^2.0.3",
    "lucide-react": "^0.544.0",
    "next": "^15.5.2",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
